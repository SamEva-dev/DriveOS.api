{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Npgsql": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithClientIp",
      "WithCorrelationId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "DriveOS.Api"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{Application}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByExcluding",
                "Args": {
                  "expression": "StartsWith(SourceContext, 'Microsoft.EntityFrameworkCore')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "%DRIVEOS_HOME%/log/DriveOS/DriveOSService_log.txt",
                  "fileSizeLimitBytes": 104857600,
                  "rollOnFileSizeLimit": true,
                  "retainedFileCountLimit": 100,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "StartsWith(SourceContext, 'Microsoft.EntityFrameworkCore')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "%DRIVEOS_HOME%/log/DriveOS/EntityFramework/EntityFramework_log.txt",
                  "fileSizeLimitBytes": 104857600,
                  "rollOnFileSizeLimit": true,
                  "retainedFileCountLimit": 100,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties}{NewLine}{Exception}",
                  "restrictedToMinimumLevel": "Information"
                }
              }
            ]
          }
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DriveOS": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AuthGateMachineTokens": {
    "Issuer": "AuthGate",
    "Audience": "DriveOS",
    "JwksUrl": "https://localhost:8081/.well-known/jwks.json",
    "RequiredClientId": "authgate",
    "RequiredScope": "driveos.provisioning",
    "JwksCacheMinutes": 15
  },
  "Authentication": {
    "AuthGate": {
      "Issuer": "AuthGate",
      "Audience": "DriveOS",
      "JwksUrl": "https://localhost:8081/.well-known/jwks.json",
      "RequiredClientId": "driveos-web",
      "RequireHttpsMetadata": true,
      "ClockSkewSeconds": 30
    }
  },
  "AuthGate": {
    "BaseUrl": "https://authgate.internal",
    "OrganizationRepresentatives": {
      "Enabled": false,
      "SynchronizePath": "/internal/organization-representatives/access",
      "RevokePath": "/internal/organization-representatives/access/revoke"
    }
  },
  "OrganizationConfigurations": {
    "CacheTtlSeconds": 300,
    "BranchOverrides": {
      "AllowedPaths": [
        "booking",
        "scheduling",
        "openingHours",
        "training.sessionDefaults",
        "communication",
        "localization"
      ],
      "LockedPaths": [
        "compliance",
        "regulation",
        "security",
        "identity",
        "billing.tax"
      ]
    }
  },
  "OrganizationSequences": {
    "Reservation": {
      "MaxConcurrencyRetries": 3
    }
  },
  "OrganizationRepresentatives": {
    "Expiration": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "BatchSize": 100
    }
  },
  "Organizations": {
    "ActivationReadiness": {
      "Cache": {
        "Enabled": true,
        "DurationSeconds": 30
      }
    }
  },
  "Crm": {
    "ActivityAttachments": {
      "RootPath": "storage/crm-activity-attachments"
    }
  },
  "StudentDocuments": {
    "RootPath": "private-data/student-documents",
    "ClamAv": {
      "Host": "127.0.0.1",
      "Port": 3310
    }
  },
  "Contracts": {
    "Documents": {
      "RootPath": "private-data/contracts"
    }
  },
  "Scheduling": {
    "Transitions": {
      "InstructorSameBranchBufferMinutes": 15,
      "InstructorCrossBranchTravelMinutes": 45,
      "VehicleSameBranchBufferMinutes": 10,
      "VehicleCrossBranchTravelMinutes": 30
    },
    "Travel": {
      "DefaultSafetyBufferMinutes": 10,
      "AllowContinuousTracking": false
    }
  },
  "TrainingDelivery": {
    "SessionExecution": {
      "PreparationLeadMinutes": 30,
      "StartEarlyToleranceMinutes": 15,
      "StartLateToleranceMinutes": 180,
      "ReadinessValidityMinutes": 5
    },
    "Attendance": {
      "RecordingEarlyToleranceMinutes": 30,
      "CorrectionWindowHours": 24
    }
  },
  "Brevo": {
    "Mode": "BREVO_API",
    "ApiBaseUrl": "https://api.brevo.com",
    "Sandbox": false,
    "SenderName": "DriveOS",
    "SenderEmail": "no-reply@driveos.app",
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": 587,
    "SmtpUseTls": true,
    "ContextTagsCsv": "driveos",
    "EnableSending": false,
    "MaxRetries": 7
  },
  "EmailDispatcher": {
    "PollSeconds": 5,
    "BatchSize": 10,
    "LockMinutes": 2
  },
  "ExamsCertification": {
    "PlaceWatcher": {
      "Enabled": true,
      "PollSeconds": 30,
      "BatchSize": 20,
      "ProcessingLeaseMinutes": 5
    },
    "SuccessConsequences": {
      "Enabled": true,
      "PollSeconds": 5,
      "BatchSize": 50,
      "ProcessingLeaseMinutes": 5,
      "DeferredRetryHours": 6,
      "ExceptionRetryMinutes": 5,
      "MaxRetryMinutes": 60
    },
    "ProviderExecution": {
      "DefaultRequestsPerMinute": 60,
      "MaxRequestsPerMinute": 600,
      "CircuitFailureThreshold": 5,
      "CircuitOpenMinutes": 2
    },
    "Analytics": {
      "SmallSampleThreshold": 10,
      "DefaultPeriodMonths": 12,
      "PassRateDropAlertPoints": 15,
      "ContextualUnderperformancePoints": 20,
      "RecurrentFailureReasonPercent": 35
    }
  },
  "RegulatoryIntegrations": {
    "TrainingRecordDispatch": {
      "Enabled": true,
      "PollSeconds": 5,
      "BatchSize": 50,
      "ProcessingLeaseMinutes": 5,
      "DefaultRetryMinutes": 5,
      "UnavailableRetryMinutes": 360,
      "MaxRetryMinutes": 60
    },
    "TrainingRecordReconciliation": {
      "Enabled": true,
      "PollSeconds": 300,
      "BatchSize": 50
    }
  },
  "ProfessionalMarketplace": {
    "ComplianceExpiration": {
      "IntervalHours": 6,
      "WarningDays": 30
    }
  },
  "FundingBilling": {
    "SupplierSettlements": {
      "OverdueCheckIntervalHours": 6
    }
  }
}
