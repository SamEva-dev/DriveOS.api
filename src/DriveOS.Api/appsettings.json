{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DriveOS": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Npgsql": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "DriveOS.Api"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{Application}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "path": "logs/driveos-.json",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 52428800,
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "AuthGateMachineTokens": {
    "Issuer": "AuthGate",
    "Audience": "DriveOS",
    "JwksUrl": "https://localhost:8081/.well-known/jwks.json",
    "RequiredClientId": "authgate",
    "RequiredScope": "driveos.provisioning",
    "JwksCacheMinutes": 15
  },
  "Authentication": {
    "AuthGate": {
      "Issuer": "AuthGate",
      "Audience": "DriveOS",
      "JwksUrl": "https://localhost:8081/.well-known/jwks.json",
      "RequiredClientId": "driveos-web",
      "RequireHttpsMetadata": true,
      "ClockSkewSeconds": 30
    }
  },
  "OrganizationConfigurations": {
    "CacheTtlSeconds": 300,
    "BranchOverrides": {
      "AllowedPaths": [
        "booking",
        "scheduling",
        "openingHours",
        "training.sessionDefaults",
        "communication",
        "localization"
      ],
      "LockedPaths": [
        "compliance",
        "regulation",
        "security",
        "identity",
        "billing.tax"
      ]
    }
  },
  "OrganizationSequences": {
    "Reservation": {
      "MaxConcurrencyRetries": 3
    }
  },
  "AuthGate": {
    "BaseUrl": "https://authgate.internal",
    "OrganizationRepresentatives": {
      "Enabled": false,
      "SynchronizePath": "/internal/organization-representatives/access",
      "RevokePath": "/internal/organization-representatives/access/revoke"
    }
  },
  "OrganizationRepresentatives": {
    "Expiration": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "BatchSize": 100
    }
  },
  "Organizations": {
    "ActivationReadiness": {
      "Cache": {
        "Enabled": true,
        "DurationSeconds": 30
      }
    }
  }
}
